{
    "name": "laranail/emojis",
    "description": "Every Unicode emoji as a fluent, typed PHP catalogue — render and convert between emoji, text, ASCII, emoticon, shortcode, image and escaped forms, for web and CLI, with a Laravel layer.",
    "keywords": [
        "laravel",
        "laranail",
        "emoji",
        "emojis",
        "unicode",
        "emoticon",
        "kaomoji",
        "shortcode",
        "twemoji",
        "cldr",
        "cli"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/emojis",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/emojis/issues",
        "source": "https://github.com/laranail/emojis",
        "docs": "https://opensource.simtabi.com/documentation/laranail/emojis/"
    },
    "require": {
        "php": "^8.4.1 || ^8.5",
        "ext-mbstring": "*",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "laranail/console": "^0.1.2",
        "laranail/package-tools": "^0.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.5.8",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "ext-dom": "Lets fromHtml() walk real DOM text nodes with PHP 8.4's \\Dom\\HTMLDocument; without it a tag-skipping scanner is used.",
        "ext-intl": "Improves grapheme handling of the text between emoji. Emoji clusters themselves never depend on ICU.",
        "laranail/validation": "Adds ->emoji() constraints to laranail/validation's fluent builder through a guarded bridge."
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Emojis\\": "src/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Emojis\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --no-coverage --colors=always",
        "test-coverage": "vendor/bin/pest --coverage --colors=always",
        "lint": [
            "@parallel-lint",
            "@pint",
            "@phpstan",
            "@deptrac",
            "@rector",
            "@sync-check",
            "@core-isolation"
        ],
        "parallel-lint": "vendor/bin/parallel-lint --exclude vendor src tests tools helpers config",
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "phpstan": [
            "vendor/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
            "vendor/bin/phpstan analyse -c phpstan-core.neon --no-progress --memory-limit=1G"
        ],
        "deptrac": "@php tools/deptrac-guard.php",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "rector-fix": "vendor/bin/rector process",
        "sync-check": "@php tools/sync-check.php",
        "core-isolation": "@php tools/core-isolation.php",
        "build-dataset": "@php tools/build-dataset.php",
        "composer-audit": "@composer audit --no-interaction",
        "format": "@pint-fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Emojis\\Providers\\EmojisServiceProvider"
            ],
            "aliases": {
                "Emojis": "Simtabi\\Laranail\\Emojis\\Facades\\Emojis"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ]
}

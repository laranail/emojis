#!/usr/bin/env bash
# Publishes @laranail/emojis-picker for every release tag not published yet, in version order. One command:
#
#   .dev/tools/npm-release              npm with the token on the clipboard; GitHub Packages if npm will not take it
#   .dev/tools/npm-release --github     GitHub Packages only (no npm token needed)
#   .dev/tools/npm-release --npm        npm only, never falling back
#   .dev/tools/npm-release --keep-token npm with the NPM_TOKEN secret already set
#   .dev/tools/npm-release v0.6.0       publish only the tags named
#   .dev/tools/npm-release --dry-run    check everything, change nothing
#   pbpaste | .dev/tools/npm-release --validate-only    check a token's shape and that npm accepts it
#
# Why a token at all: this repository issues GitHub's immutable OIDC subject, which npm's trusted publishing
# does not accept yet (npm/cli#9969). GitHub Packages needs none: the workflow publishes there with its own
# GITHUB_TOKEN. See docs/tools/picker.md.
#
# The token is never printed, never put on a command line (curl reads the header from stdin, gh reads the
# secret from stdin) and never written to disk. Only its length, line count and stray characters are reported.

set -euo pipefail

REPO=laranail/emojis
PACKAGE=@laranail/emojis-picker
WORKFLOW=npm-publish.yml
REGISTRY=${NPM_RELEASE_REGISTRY:-https://registry.npmjs.org} # overridable for the tests only
PACKAGE_URL="$REGISTRY/@laranail%2femojis-picker"

keep_token=false dry_run=false validate_only=false target=auto
tags=()
for arg in "$@"; do
  case "$arg" in
    --keep-token) keep_token=true ;;
    --dry-run) dry_run=true ;;
    --validate-only) validate_only=true ;;
    --github) target=github ;;
    --npm) target=npm ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    v[0-9]*.[0-9]*.[0-9]*) tags+=("$arg") ;;
    *) echo "npm-release: unknown argument '$arg' (see --help)" >&2; exit 64 ;;
  esac
done

say() { printf '==> %s\n' "$*"; }
die() { printf 'npm-release: %s\n' "$1" >&2; exit "${2:-1}"; }

# Reads the candidate token from stdin when something is piped in, otherwise from the clipboard.
read_token() {
  if [ ! -t 0 ]; then cat; elif command -v pbpaste >/dev/null; then pbpaste; else die "no token: pipe it in, or run on macOS to read the clipboard" 2; fi
}

# Copying from a web page can carry characters nobody can see: zero-width spaces, a byte-order mark, a soft
# hyphen, non-breaking spaces at either end. None of them is ever part of a token, so they are removed here and
# named (as U+XXXX, never the token's own characters) so the paste that carried them is not a mystery.
clean_token() {
  perl -CSD -0777 -ne '
    my %removed;
    s/([\x{200B}-\x{200D}\x{2060}\x{FEFF}\x{00AD}])/$removed{sprintf("U+%04X", ord $1)}++; ""/ge;
    s/\r//g;
    s/^[\s\p{Zs}]+|[\s\p{Zs}]+$//g;
    print STDERR "==> removed invisible characters from the paste: ", join(" ", sort keys %removed), "\n" if %removed;
    print;
  '
}

# A granular or automation token is one line: npm_ and letters and digits. Anything else (a token ID, a copied
# page, a partial paste) is refused here, before it reaches GitHub, with its length, its line count and any
# character a token never contains, as U+XXXX. The token's own letters and digits are never shown.
check_shape() {
  local token=$1 lines prefix stray length
  lines=$(printf '%s\n' "$token" | wc -l | tr -d ' ')
  # grep matches line by line, so the line count is checked too: two tokens pasted together are not one.
  if [ "$lines" -ne 1 ] || ! printf '%s' "$token" | grep -Eq '^npm_[A-Za-z0-9_]{30,}$'; then
    case "$token" in npm_*) prefix='starts with npm_' ;; *) prefix='does not start with npm_' ;; esac
    # Characters, not bytes, whatever the locale: bash's ${#token} counts bytes outside a UTF-8 locale.
    length=$(printf '%s' "$token" | perl -CSD -0777 -ne 'print length')
    stray=$(printf '%s' "$token" | perl -CSD -0777 -ne 'my %u; $u{sprintf("U+%04X", ord $1)}++ while /([^A-Za-z0-9_\n])/g; print join(" ", sort keys %u)')
    die "that is not an npm token: $length characters on $lines line(s), $prefix${stray:+, contains $stray}. Copy the token npm shows once after 'Generate token' (npm_ and letters and digits), not the token's ID or the page." 2
  fi
}

# Asks the registry who the token belongs to. The header goes through stdin so the token never appears in ps.
# npm's answer is reported as it came: its status and its own message, which never contain the token. Only a
# 401 is a refusal; granular tokens may be denied this lookup and still publish, so anything else continues
# and the publish is the real test.
verify_token() {
  local response code body user message
  response=$(printf 'Authorization: Bearer %s\n' "$1" | curl -sS -H @- -w '\n%{http_code}' "$REGISTRY/-/whoami") \
    || die "could not reach $REGISTRY" 3
  code=${response##*$'\n'}
  body=${response%$'\n'*}
  user=$(printf '%s' "$body" | jq -r '.username // empty' 2>/dev/null || true)
  message=$(printf '%s' "$body" | jq -r '.error // .message // empty' 2>/dev/null || true)
  if [ "$code" = 200 ] && [ -n "$user" ]; then
    say "token accepted by npm as: $user"
  elif [ "$code" = 401 ]; then
    die "npm answered HTTP 401${message:+ ($message)}: it does not accept this token. It is mistyped, revoked or expired; the secret was not changed" 2
  else
    say "npm answered HTTP $code to who-am-I${message:+ ($message)}; some granular tokens cannot ask that, so continuing and letting the publish decide"
  fi
}

if $validate_only; then
  token=$(read_token | clean_token)
  check_shape "$token"
  verify_token "$token"
  exit 0
fi

for tool in gh jq curl git; do command -v "$tool" >/dev/null || die "$tool is required"; done
login=$(gh api user --jq .login) || die "gh is not signed in"
# Dispatching a workflow and setting a secret need the personal login: the GitHub app answers 403 to both.
[ "$login" = imanimanyara ] || die "gh is signed in as '$login'; switch to imanimanyara (gh auth switch -u imanimanyara)"
[ "$(gh variable get NPM_PUBLISH -R "$REPO" 2>/dev/null || true)" = true ] || die "the repository variable NPM_PUBLISH is not 'true', so the workflow would skip the publish"

# Every version npm already has, then every release tag it does not, oldest first, so 'latest' ends on the newest.
# Pre-release versions (npm's 0.0.0-stage placeholder among them) never count as the newest release.
published=$(curl -sS "$PACKAGE_URL" | jq -r '.versions // {} | keys[]') || die "could not read $PACKAGE from $REGISTRY" 3
highest=$(printf '%s\n' "$published" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)
if [ ${#tags[@]} -eq 0 ]; then
  while IFS= read -r t; do
    v=${t#v}
    printf '%s\n' "$published" | grep -qxF "$v" && continue
    # Tags older than the newest published version predate the npm package or were superseded: name them to publish.
    [ -n "$highest" ] && [ "$(printf '%s\n%s\n' "$highest" "$v" | sort -V | tail -1)" = "$highest" ] && continue
    tags+=("$t")
  done < <(git ls-remote --tags --refs "https://github.com/$REPO" 'v*' | sed 's#.*refs/tags/##' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V)
fi
say "npm has: ${highest:-nothing}; to publish: ${tags[*]:-nothing}"
[ ${#tags[@]} -gt 0 ] || exit 0

# GitHub Packages' versions, when the gh login may read them (read:packages); empty otherwise.
github_versions() {
  gh api "orgs/laranail/packages/npm/emojis-picker/versions" --paginate --jq '.[].name' 2>/dev/null || true
}

# Starts one publish and waits for it. Returns non-zero when the run fails, after showing why.
publish() {
  local tag=$1 registry=$2 out run
  if $dry_run; then say "dry run: would publish $tag to $registry"; return 0; fi
  say "publishing $tag to $registry"
  out=$(gh workflow run "$WORKFLOW" -R "$REPO" -f tag="$tag" -f registry="$registry" 2>&1) || { printf '%s\n' "$out" >&2; return 1; }
  # gh prints the new run's URL; reading it avoids picking up someone else's run.
  run=$(printf '%s\n' "$out" | grep -oE '/actions/runs/[0-9]+' | grep -oE '[0-9]+$' | head -1)
  [ -n "$run" ] || { printf 'gh did not report the run it started: %s\n' "$out" >&2; return 1; }
  say "run https://github.com/$REPO/actions/runs/$run"
  if ! gh run watch "$run" -R "$REPO" --exit-status >/dev/null; then
    gh run view "$run" -R "$REPO" --log-failed | grep -E 'error|warning' | cut -c1-240 | tail -20 >&2 || true
    return 1
  fi
}

on_npm() {
  local version=$1
  for _ in $(seq 1 12); do
    [ "$(curl -sS "$PACKAGE_URL/$version" | jq -r '.version // empty' 2>/dev/null)" = "$version" ] && return 0
    sleep 5
  done
  return 1
}

# Decide the registry. npm needs a token npm accepts; in the default mode, anything short of that (no token on the
# clipboard, the wrong text, a 401) is reported and the release goes to GitHub Packages instead.
use=$target
if [ "$use" != github ] && ! $keep_token; then
  token=$(read_token 2>/dev/null | clean_token || true)
  if ( check_shape "$token" && verify_token "$token" ); then
    use=npm
    if $dry_run; then
      say "dry run: would set NPM_TOKEN on $REPO"
    else
      before=$(gh api "repos/$REPO/actions/secrets/NPM_TOKEN" --jq .updated_at 2>/dev/null || echo none)
      printf '%s' "$token" | gh secret set NPM_TOKEN -R "$REPO" >/dev/null
      after=$(gh api "repos/$REPO/actions/secrets/NPM_TOKEN" --jq .updated_at)
      [ "$after" != "$before" ] || die "GitHub still reports NPM_TOKEN updated at $before: the secret did not change"
      say "NPM_TOKEN updated at $after (was $before)"
    fi
  elif [ "$use" = npm ]; then
    die "npm needs a token it accepts (see above); run with --github to publish to GitHub Packages instead" 2
  else
    say "no npm token npm accepts, so publishing to GitHub Packages instead"
    use=github
  fi
  unset token
elif [ "$use" = auto ]; then
  use=npm # --keep-token: the secret already set decides
fi

if [ "$use" = npm ]; then
  for i in "${!tags[@]}"; do
    tag=${tags[$i]}
    if publish "$tag" npm; then
      $dry_run && continue
      on_npm "${tag#v}" || die "the run passed but $PACKAGE@${tag#v} is not on npm yet"
      say "$PACKAGE@${tag#v} is on npm"
    elif [ "$target" = auto ]; then
      # Keep the order: this tag and every later one go to GitHub Packages.
      say "npm refused $tag, so it and the tags after it go to GitHub Packages"
      tags=("${tags[@]:$i}")
      use=github
      break
    else
      die "$tag did not publish to npm; later tags were not started, so the versions stay in order"
    fi
  done
  [ "$use" = npm ] && { $dry_run || say "npm latest is now $(curl -sS "$PACKAGE_URL" | jq -r '.["dist-tags"].latest')"; exit 0; }
fi

existing=$(github_versions)
for tag in "${tags[@]}"; do
  if printf '%s\n' "$existing" | grep -qxF "${tag#v}"; then say "$PACKAGE@${tag#v} is already on GitHub Packages"; continue; fi
  publish "$tag" github || die "$tag did not publish to GitHub Packages; later tags were not started, so the versions stay in order"
  $dry_run && continue
  if [ -z "$existing" ] && [ -z "$(github_versions)" ]; then
    say "$tag published (the run passed; listing GitHub Packages needs read:packages on the gh login, so not re-checked)"
  else
    github_versions | grep -qxF "${tag#v}" || die "the run passed but $PACKAGE@${tag#v} is not listed on GitHub Packages"
    say "$PACKAGE@${tag#v} is on GitHub Packages"
  fi
done
$dry_run || say "installs from GitHub Packages need, in the consuming project's .npmrc: @laranail:registry=https://npm.pkg.github.com, and a token with read:packages"
